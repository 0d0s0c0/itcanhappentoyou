generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Incident {
  id          Int      @id @default(autoincrement())
  date        DateTime
  latitude    Float
  longitude   Float
  description String
  title       String
  official    Boolean  @default(true)
  category    String

  createdAt   DateTime @default(now())

  @@index([latitude, longitude])
}
